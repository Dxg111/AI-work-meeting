# =============================================
# 数据库配置
# =============================================
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=db_meeting_minutes

# =============================================
# JWT 配置（阶段2使用）
# =============================================
JWT_SECRET=your-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# =============================================
# 文件上传配置
# =============================================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=524288000
PUBLIC_BASE_URL=http://localhost:8000

# 头像上传
MAX_AVATAR_SIZE=2097152
ALLOWED_AVATAR_EXTENSIONS=[".jpg", ".jpeg", ".png", ".gif", ".webp"]

# =============================================
# ASR 配置
# =============================================
ASR_PROVIDER=funasr
ASR_BASE_URL=https://dashscope.aliyuncs.com/api/v1
ASR_MODEL=paraformer-v2
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# =============================================
# LLM 配置
# =============================================
LLM_PROVIDER=qwen
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_MAP_THRESHOLD_CHARS=8000
LLM_MAP_CHUNK_CHARS=6000
LLM_MAP_MAX_CHUNKS=20

# =============================================
# 调度器配置
# =============================================
ASR_POLL_INTERVAL=10
ASR_TASK_TIMEOUT_SECONDS=7200
PIPELINE_RECOVERY_INTERVAL=60
LLM_STUCK_TIMEOUT_SECONDS=1800
TRANSCRIBED_STUCK_TIMEOUT_SECONDS=120

# =============================================
# 应用配置
# =============================================
DEBUG=True
API_PREFIX=/api
